# ── Produits par le rendu (quarto render) ───────────────────────────────
/_book/
/.quarto/
/_etiquettes.json
/_bibliographie-web.json
/figures/web/
/sol-ch*.tex
**/*.quarto_ipynb

# ── Fichiers intermédiaires de LaTeX (compilation du PDF) ───────────────
/*.tex
/*.pdf
/*.aux
/*.bbl
/*.bcf
/*.blg
/*.log
/*.out
/*.run.xml
/*.toc
/*.fls
/*.fdb_latexmk
/*.synctex.gz
# Quarto compile sous le nom index.* : on garde seulement index.qmd
/index.*
!/index.qmd

# ── Présentations Beamer : seulement les sources ─────────────────────────
# Les PDF sont produits par _outils/compiler-presentations.sh (localement
# ou par GitHub Actions) et publiés dans _book/presentations/.
/Beamer/**/*.aux
/Beamer/**/*.log
/Beamer/**/*.nav
/Beamer/**/*.out
/Beamer/**/*.snm
/Beamer/**/*.toc
/Beamer/**/*.vrb
/Beamer/**/*.listing
/Beamer/**/*.fls
/Beamer/**/*.fdb_latexmk
/Beamer/**/*.synctex.gz
/Beamer/**/*.pdf

# ── Applications Shiny ───────────────────────────────────────────────────
# Environnements Python (à recréer : voir README.md)
**/.venv/
# Version shinylive exportée (régénérée par shiny/exporter.sh)
/applications/

# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.pyc

# ── Système et éditeurs ──────────────────────────────────────────────────
.DS_Store
*.swp
.vscode/
.idea/

# Copies de conflit d'iCloud (« fichier 2.tex », « fichier 3.qmd »...)
* [0-9].*
/CommentairesAnne-Sophie.txt
