\begin{tikzpicture}[scale=1.05, vue3d]
  % le plan z = x + y, paramétré par s u + t v, s, t dans [-0.6, 1.6]
  \fill[steelblue4!15, draw=steelblue4!60]
    (-0.6,-0.6,-1.2) -- (1.6,-0.6,1.0) -- (1.6,1.6,3.2) -- (-0.6,1.6,1.0) -- cycle;
  \draw[axe] (0,0,0) -- (2.4,0,0) node[etiq, below left] {$x$};
  \draw[axe] (0,0,0) -- (0,2.4,0) node[etiq, right] {$y$};
  \draw[axe] (0,0,0) -- (0,0,3.4) node[etiq, above] {$z$};
  \draw[fleche] (0,0,0) -- (1,0,1) node[etiq, left] {$\vec{u}$};
  \draw[fleche] (0,0,0) -- (0,1,1) node[etiq, above left] {$\vec{v}$};
  \draw[fleche, steelblue4] (0,0,0) -- (1,1,2)
    node[etiq, right] {$\vec{u} + \vec{v} = (1,1,2)$};
  \draw[gray!60, dashed] (1,1,2) -- (1,1,3);
  \draw[fleche, firebrick3] (0,0,0) -- (1,1,3)
    node[etiq, above] {$(1,1,3)$};
  \node[etiq, steelblue4] at (1.5,1.5,3.0) [right=4pt] {$\Span\{\vec{u}, \vec{v}\}$};
\end{tikzpicture}
