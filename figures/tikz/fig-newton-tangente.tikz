\begin{tikzpicture}[xscale=1.3, yscale=0.5]
  \draw[axe] (1.6,0) -- (5.7,0) node[below, etiq]{$x$};
  \draw[sectioncolor, thick, domain=1.8:5.4, samples=60, smooth]
    plot (\x, {(\x-2)*(\x-2)-3}) node[right, etiq, sectioncolor]{$y=f(x)$};
  \draw[firebrick3, thick, domain=3.7:5.6] plot (\x, {6*\x-24});
  \draw[coveraccent, thick, domain=3.4:4.7] plot (\x, {4*\x-15});
  \draw[sectioncolor!40, thin, dotted] (5,0) -- (5,6);
  \draw[sectioncolor!40, thin, dotted] (4,0) -- (4,1);
  \node[pt, label={[etiq]above:$x_0$}] at (5,0) {};
  \node[pt, label={[etiq]above:$x_1$}] at (4,0) {};
  \node[ptim, label={[etiq]below:$x_2\approx x^\star$}] at (3.75,0) {};
\end{tikzpicture}
