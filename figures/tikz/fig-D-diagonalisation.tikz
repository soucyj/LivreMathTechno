\begin{tikzpicture}[scale=0.62]
  \begin{scope}
    \clip (-2.9,-2.9) rectangle (2.9,2.9);
    \begin{scope}[rotate=45]
      \draw[steelblue4!30] (-5,-5) grid (5,5);
      \fill[fig] \motifF;
    \end{scope}
  \end{scope}
  \draw[axe] (-2.9,0) -- (3.2,0) node[etiq, below] {$x$};
  \draw[axe] (0,-2.9) -- (0,3.2) node[etiq, left] {$y$};
  \draw[fleche] (0,0) -- (45:1) node[etiq, above] {$\vec{v}_1$};
  \draw[fleche] (0,0) -- (135:1) node[etiq, above] {$-\vec{v}_2$};
  \draw[-{Stealth[length=2.4mm]}, thick, gray] (3.6,0) -- node[etiq, above] {$A$} (5.2,0);
  \begin{scope}[xshift=9.4cm]
    \begin{scope}
      \clip (-3.9,-2.9) rectangle (3.9,2.9);
      \begin{scope}[rotate=45, xscale=3]
        \draw[firebrick3!30] (-5,-5) grid (5,5);
        \fill[figim] \motifF;
      \end{scope}
    \end{scope}
    \draw[axe] (-3.9,0) -- (4.2,0) node[etiq, below] {$x$};
    \draw[axe] (0,-2.9) -- (0,3.2) node[etiq, left] {$y$};
    \draw[fleche, firebrick3] (0,0) -- (45:3) node[etiq, above] {$3\vec{v}_1$};
    \draw[fleche, firebrick3] (0,0) -- (135:1) node[etiq, above] {$-\vec{v}_2$};
  \end{scope}
\end{tikzpicture}
