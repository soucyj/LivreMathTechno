\begin{tikzpicture}[scale=0.85, vue3d]
  % (a) trois plans sécants en un point : les plans de coordonnées
  \begin{scope}
    \fill[steelblue4!25, draw=steelblue4!70, fill opacity=0.7]
      (-1,-1,0) -- (1.3,-1,0) -- (1.3,1.3,0) -- (-1,1.3,0) -- cycle;
    \fill[firebrick3!20, draw=firebrick3!70, fill opacity=0.6]
      (-1,0,-1) -- (1.3,0,-1) -- (1.3,0,1.3) -- (-1,0,1.3) -- cycle;
    \fill[coveraccent!25, draw=coveraccent!80!black, fill opacity=0.6]
      (0,-1,-1) -- (0,1.3,-1) -- (0,1.3,1.3) -- (0,-1,1.3) -- cycle;
    \node[pt] at (0,0,0) {};
    \node[etiq] at (0,0.15,-1.9) {un point};
  \end{scope}
  % (b) trois plans contenant une même droite (le « livre ouvert »)
  \begin{scope}[shift={(0,4.2,0)}]
    \foreach \a/\c in {0/steelblue4, 60/firebrick3, 120/coveraccent}{
      \fill[\c!22, draw=\c!75, fill opacity=0.6]
        ({-1.2*cos(\a)},{-1.2*sin(\a)},-1) -- ({1.2*cos(\a)},{1.2*sin(\a)},-1)
        -- ({1.2*cos(\a)},{1.2*sin(\a)},1.3) -- ({-1.2*cos(\a)},{-1.2*sin(\a)},1.3) -- cycle;}
    \draw[sectioncolor, very thick] (0,0,-1) -- (0,0,1.3);
    \node[etiq] at (0,0.15,-1.9) {une droite};
  \end{scope}
  % (c) trois plans formant un prisme : aucune solution
  \begin{scope}[shift={(0,8.4,0)}]
    \foreach \p/\q/\c in {{-1.4,-0.8}/{1.4,-0.8}/steelblue4,
                          {1.0,-1.35}/{-0.4,1.15}/firebrick3,
                          {-1.0,-1.35}/{0.4,1.15}/coveraccent}{
      \fill[\c!22, draw=\c!75, fill opacity=0.6]
        (\p,-1) -- (\q,-1) -- (\q,1.3) -- (\p,1.3) -- cycle;}
    \node[etiq] at (0,0.15,-1.9) {aucune solution};
  \end{scope}
\end{tikzpicture}
