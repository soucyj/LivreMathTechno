\begin{tikzpicture}[scale=3.3]
  \begin{scope}
    \draw[sectioncolor!60, dashed, thin] (0,0) rectangle (1,1);
    \input{figures/fractales/chevauchement-disjoint.tikz}
    \node[etiq, align=center] at (0.5,-0.2) {(a) trois copies de rapport $\num{0.48}$ :\\ disjointes};
  \end{scope}
  \begin{scope}[shift={(1.35,0)}]
    \draw[sectioncolor!60, dashed, thin] (0,0) rectangle (1,1);
    \input{figures/fractales/chevauchement-touche.tikz}
    \node[etiq, align=center] at (0.5,-0.2) {(b) rapports $\tfrac12$, $\num{0.4}$ et $\tfrac12$ :\\ elles se touchent};
  \end{scope}
  \begin{scope}[shift={(2.7,0)}]
    \foreach \x/\y in {0/0, 0.5/0, 0/0.5, 0.5/0.5}
      \fill[steelblue4, fill opacity=0.35] (\x,\y) rectangle ++(0.5,0.5);
    \fill[firebrick3, fill opacity=0.45] (0.25,0.25) rectangle ++(0.5,0.5);
    \draw[sectioncolor!60, dashed, thin] (0,0) rectangle (1,1);
    \node[etiq, align=center] at (0.5,-0.2) {(c) cinq copies de rapport $\tfrac12$ :\\ elles se chevauchent};
  \end{scope}
\end{tikzpicture}
