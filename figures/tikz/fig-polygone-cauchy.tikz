\begin{tikzpicture}[scale=1]
  \node[pt, label={[etiq]below:$x_n$}] (xn) at (0,0) {};
  \node[pt, label={[etiq]above:$x_{n+1}$}] (xn1) at (1.3,0.75) {};
  \node[pt, label={[etiq]above:$x_{n+2}$}] (xn2) at (2.35,1.05) {};
  \node[etiq] (dots) at (3.35,0.7) {$\cdots$};
  \node[pt, label={[etiq]below:$x_{n+p-1}$}] (xnp1) at (4.35,0.35) {};
  \node[pt, label={[etiq]above:$x_{n+p}$}] (xnp) at (5.6,1.1) {};
  \draw[sectioncolor, thick] (xn) -- (xn1) -- (xn2);
  \draw[sectioncolor, thick, dashed] (xn2) -- (xnp1);
  \draw[sectioncolor, thick] (xnp1) -- (xnp);
  \draw[firebrick3, thick, dashed] (xn) --
    node[midway, below, etiq, firebrick3]{$\dE(x_n,x_{n+p})$} (xnp);
\end{tikzpicture}
