  \begin{tikzpicture}[scale=0.8]
    \draw[quadrillage] (-0.6,-0.6) grid (3.6,2.6);
    \draw[axe] (-0.6,0) -- (3.9,0) node[etiq, below] {$x$};
    \draw[axe] (0,-0.6) -- (0,2.9) node[etiq, left] {$y$};
    \foreach \x/\y in {1/1, 3/2}
      {\fill[firebrick3!18] (\x-0.5,\y-0.5) rectangle (\x+0.5,\y+0.5);
       \node[ptim] at (\x,\y) {};}
  \end{tikzpicture}
