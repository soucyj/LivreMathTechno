  \begin{tikzpicture}[scale=1.6]
    \draw[gray!70, line width=2.2pt] (0.25,0) -- (0.25,1.5);
    \draw[gray!70, line width=2.2pt] (1.25,0) -- (1.25,2.5);
    \draw[gray!70, line width=2.2pt] (2.25,0) -- (2.25,2.5);
    \draw[gray!70, line width=2.2pt] (0,0.25) -- (2.5,0.25);
    \draw[gray!70, line width=2.2pt] (0,1.25) -- (2.5,1.25);
    \draw[gray!70, line width=2.2pt] (1,2.25) -- (2.5,2.25);
    \foreach \x/\y/\n in {0.25/0.25/6, 0.25/1.25/3, 1.25/0.25/7,
        1.25/1.25/4, 1.25/2.25/1, 2.25/0.25/8, 2.25/1.25/5, 2.25/2.25/2}{
      \fill[sectioncolor] (\x,\y) circle (2.2pt);
      \node[etiq, fill=white, inner sep=1pt, above right=2pt] at (\x,\y) {$\n$};}
  \end{tikzpicture}
