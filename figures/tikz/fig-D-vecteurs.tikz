\begin{tikzpicture}[scale=0.8]
  \begin{scope}
    \repere{-2.6}{3.6}{-1.6}{4.6}
    \fill[fig, fill opacity=0.5] (0,0) -- (2,1) -- (3,4) -- (1,3) -- cycle;
    \draw[fleche] (0,0) -- (2,1) node[etiq, below right] {$\vec{u}$};
    \draw[fleche] (0,0) -- (1,3) node[etiq, left] {$\vec{v}$};
    \draw[fleche, firebrick3] (0,0) -- (3,4)
      node[etiq, right] {$\vec{u} + \vec{v}$};
    \draw[fleche, coveraccent] (0,0) -- (-2,-1)
      node[etiq, below] {$-\vec{u}$};
  \end{scope}
  \begin{scope}[xshift=8.3cm, y=1cm, vue3d]
    \draw[axe] (0,0,0) -- (3.3,0,0) node[etiq, below left] {$x$};
    \draw[axe] (0,0,0) -- (0,3.8,0) node[etiq, right] {$y$};
    \draw[axe] (0,0,0) -- (0,0,3) node[etiq, above] {$z$};
    % boîte de coordonnées du point (2,3,2)
    \draw[gray!60, dashed] (2,0,0) -- (2,3,0) -- (0,3,0);
    \draw[gray!60, dashed] (2,3,0) -- (2,3,2);
    \draw[gray!60, dashed] (0,0,2) -- (2,0,2) -- (2,3,2) -- (0,3,2) -- cycle;
    \draw[gray!60, dashed] (2,0,0) -- (2,0,2);
    \draw[gray!60, dashed] (0,3,0) -- (0,3,2);
    \draw[fleche] (0,0,0) -- (2,3,2)
      node[etiq, above right] {$\vec{w} = (2,3,2)$};
    \node[etiq, left] at (2,0,0) {$2$};
    \node[etiq, below] at (0,3,0) {$3$};
    \node[etiq, left] at (0,0,2) {$2$};
  \end{scope}
\end{tikzpicture}
