\begin{tikzpicture}[scale=1.7]
  \draw[fig] (-0.4,-0.6) rectangle (3.6,2.4);
  \node[etiq, sectioncolor] at (0.1,2.0) {$\R^2$};
  \node[pt, label={[etiq]below left:$x_0$}] (x0) at (0.5,0.35) {};
  \node[pt, label={[etiq]below:$x_1$}] (x1) at (1.8,0.95) {};
  \node[pt, label={[etiq]right:$x_2$}] (x2) at (2.3,1.45) {};
  \node[ptim, label={[etiq]above:$\overline{x}$}] (xbar) at (2.6,1.75) {};
  \draw[fleche, sectioncolor] (x0) to[bend left=15] node[midway, below right, etiq]{$f$} (x1);
  \draw[fleche, sectioncolor] (x1) to[bend left=15] node[midway, above left, etiq]{$f$} (x2);
  \draw[sectioncolor!50, thick, dotted] (x2) to[bend left=15] (xbar);
\end{tikzpicture}
