\begin{tikzpicture}[scale=0.95]
  \begin{scope}
    \repere{-1.6}{1.6}{-1.6}{1.6}
    \draw[fig, fill opacity=0.4] (0,0) circle (1);
    \draw[fleche] (0,0) -- (45:1) node[etiq, above right] {$\vec{v}_1$};
    \draw[fleche] (0,0) -- (-45:1) node[etiq, below right] {$\vec{v}_2$};
    \draw[fleche, coveraccent] (0,0) -- (1,0) node[etiq, right] {$\vec{e}_1$};
  \end{scope}
  \draw[-{Stealth[length=2.4mm]}, thick, gray] (2.2,0) -- node[etiq, above] {$A$} (3.4,0);
  \begin{scope}[xshift=6.6cm]
    \repere{-2.6}{2.6}{-2.6}{2.6}
    \draw[figim, fill opacity=0.4, rotate=45] (0,0) ellipse (3 and 1);
    \draw[droite, gray!60] (-2.6,-2.6) -- (2.6,2.6);
    \draw[droite, gray!60] (-1.2,1.2) -- (1.2,-1.2);
    \draw[fleche, firebrick3] (0,0) -- (45:3) node[etiq, right] {$A\vec{v}_1 = 3\vec{v}_1$};
    \draw[fleche, firebrick3] (0,0) -- (-45:1) node[etiq, below right] {$A\vec{v}_2 = \vec{v}_2$};
    \draw[fleche, coveraccent] (0,0) -- (2,1) node[etiq, right] {$A\vec{e}_1$};
  \end{scope}
\end{tikzpicture}
