\begin{tikzpicture}[scale=1.05]
  \repere{-1.4}{2.4}{-1.4}{2.4}
  \draw[droite] (-1.3,-1.3) -- (2.3,2.3) node[etiq, right, black] {$y=x$};
  \fill[fig] \motifF;
  % Image du motif : le point (x,y) va sur ((x+y)/2, (x+y)/2). La somme
  % x+y varie de 0, au coin (0,0), à 1,75, au coin (0,75 ; 1) ; l'image
  % est donc le segment allant de (0,0) à (0,875 ; 0,875).
  \draw[firebrick3, ultra thick] (0,0) -- (0.875,0.875);
  \foreach \x/\y in {0/1, 0.75/1, 0.3/0, 0.6/0.55}
    {\draw[gray!70, thin, dotted] (\x,\y) -- ({(\x+\y)/2},{(\x+\y)/2});
     \node[pt, inner sep=0.7pt] at (\x,\y) {};
     \node[ptim, inner sep=0.7pt] at ({(\x+\y)/2},{(\x+\y)/2}) {};}
\end{tikzpicture}
