\begin{tikzpicture}[scale=1.05]
  \node[pageweb] (p1) at (0,2.4) {$1$};
  \node[pageweb] (p5) at (3.2,2.4) {$5$};
  \node[pageweb] (p2) at (0,0) {$2$};
  \node[pageweb] (p3) at (2.2,0) {$3$};
  \node[pageweb] (p4) at (4.4,0) {$4$};
  \node[pageweb, fill=firebrick3!15, draw=firebrick3] (p6) at (3.2,4.4) {$6$};
  \draw[lien2] (p1) -- (p2);
  \draw[lien2] (p2) -- (p3);
  \draw[lien2] (p3) -- (p4);
  \draw[lien] (p3) -- (p5);
  \draw[lien] (p4) -- (p5);
  \draw[lien] (p5) -- (p1);
  \draw[lien] (p5) -- (p2);
  \draw[lien] (p5) -- (p6);
\end{tikzpicture}
