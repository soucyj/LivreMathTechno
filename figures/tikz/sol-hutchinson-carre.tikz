\begin{tikzpicture}[scale=2.3]
  \foreach \x/\t in {0/{$C$}, 1.45/{$W(C)$}, 2.9/{$W^2(C)$}, 4.35/{$\dH(W(C),C)$}}{
    \begin{scope}[shift={(\x,0)}]
      \draw[gray!50, thin] (0,0) rectangle (1,1);
      \node[etiq] at (0.5,-0.14) {\t};
    \end{scope}}
  \fill[fig] (0,0) rectangle (1,1);
  \begin{scope}[shift={(1.45,0)}]
    \fill[fig] (0,0) rectangle (1/3,1/3); \fill[fig] (2/3,0) rectangle (1,1/3);
  \end{scope}
  \begin{scope}[shift={(2.9,0)}]
    \foreach \a in {0, 2/9, 2/3, 8/9} \fill[fig] (\a,0) rectangle ++(1/9,1/9);
  \end{scope}
  \begin{scope}[shift={(4.35,0)}]
    \fill[fig] (0,0) rectangle (1/3,1/3); \fill[fig] (2/3,0) rectangle (1,1/3);
    \draw[firebrick3, thick] (1/2,1) -- (1/3,1/3);
    \draw[firebrick3, thick, dashed] (1/2,1) -- (2/3,1/3);
    \node[ptim, label={[etiq]above:$P$}] at (1/2,1) {};
  \end{scope}
\end{tikzpicture}
